# Copy this file to .env.local after you create a free Supabase project.
# Leave the values empty and Hazri keeps marks in this browser only.
# No credit card. The demo still runs with npm install and npm run dev.
#
# Supabase → Project Settings → API:
#   Project URL        → VITE_SUPABASE_URL
#   anon public key    → VITE_SUPABASE_ANON_KEY
# Then run the SQL in supabase/schema.sql once.
#
# The table registers holds, per school: phones, attendance, staff, cover, alerts.
# Later those can be split into school, person, student, attendance,
# staff_attendance, cover, and alert.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
